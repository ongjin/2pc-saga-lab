    R->>O: query pg_prepared_xacts
    R->>P: query pg_prepared_xacts
    R->>I: query pg_prepared_xacts
    R->>O: COMMIT PREPARED
    R->>P: COMMIT PREPARED
    R->>I: COMMIT PREPARED
